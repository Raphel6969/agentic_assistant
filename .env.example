# ── LLM Providers ─────────────────────────────────────────────────────────────
GROQ_API_KEY=                              # https://console.groq.com
OPENROUTER_API_KEY=                        # https://openrouter.ai/keys

# ── LLM Routing Config ────────────────────────────────────────────────────────
LLM_BACKEND=groq                           # "groq" | "openrouter"
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
FAST_MODEL=llama-3.1-8b-instant            # cheap/fast: tool routing, classification
PLANNER_MODEL=llama-3.3-70b-versatile      # capable: multi-step planning
FALLBACK_MODEL=deepseek/deepseek-v4-flash  # openrouter fallback

# ── Database ──────────────────────────────────────────────────────────────────
# Local machine:
POSTGRES_URL=postgresql://localhost:aeri3107@localhost:5432/airline_db
# Docker Compose internal network:
# POSTGRES_URL=postgresql://localhost:aeri3107@postgres:5432/airline_db

# ── Agent Budget ──────────────────────────────────────────────────────────────
BUDGET_CEILING_DEFAULT=500                 # Default task budget in USD
