# ── LLM Providers ─────────────────────────────────────────────────────────────
# Fill in at least one. Leave the other blank.
GROQ_API_KEY=                              # https://console.groq.com
OPENROUTER_API_KEY=                        # https://openrouter.ai/keys

# ── LLM Routing (pre-filled with recommended models) ──────────────────────────
LLM_BACKEND=groq                           # "groq" | "openrouter"
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
FAST_MODEL=gpt-oss-20b                     # cheap/fast: tool routing, classification
PLANNER_MODEL=llama-3.3-70b-versatile      # capable: multi-step planning
FALLBACK_MODEL=deepseek/deepseek-v4-flash  # openrouter fallback if groq rate-limits

# ── Database ──────────────────────────────────────────────────────────────────
# Local Docker Postgres — works with `docker compose up` out of the box
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/agent
# Cloud (swap when deploying to Supabase):
# POSTGRES_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres

# ── Agent Budget ──────────────────────────────────────────────────────────────
BUDGET_CEILING_DEFAULT=500                 # Default task budget in USD for demo
